{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/ai-catalog.json",
        "destination": "/ai-catalog.json"
      },
      {
        "source": "/.well-known/ard.json",
        "destination": "/ai-catalog.json"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
